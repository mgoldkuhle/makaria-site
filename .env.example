# Supabase — events table, read with the anon key through PostgREST.
# The anon key is public by design; the table needs an RLS policy that lets
# `anon` SELECT, otherwise the request returns an empty array.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key>"

# Cloudflare folder holding the event images. A row's `image` column is joined
# onto this, so it can hold just a filename (e.g. "stiftungsfest-2027.jpg").
VITE_EVENT_IMAGE_BASE="https://<bucket>.r2.dev/events"
